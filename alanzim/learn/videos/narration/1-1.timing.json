{
 "id": "1-1",
 "voice": "onwK4e9ZLuTAKqWW03F9",
 "script_hash": "b67ffaa49d9ffae094bf4d52a204099b22d43078548976f283e31886823a88cf",
 "duration": 65.34,
 "sentences": [
  {
   "beat": "triangle",
   "show": "Every fire, from a candle to a spacecraft emergency, needs three things at once: fuel, oxygen, and heat.",
   "start": 0.0,
   "end": 7.651
  },
  {
   "beat": "remove",
   "show": "Take any one of them away, and the fire goes out.",
   "start": 8.057,
   "end": 11.227
  },
  {
   "beat": "pillars",
   "show": "That simple triangle is the basis of fire safety: prevent, detect, and suppress.",
   "start": 11.796,
   "end": 18.332
  },
  {
   "beat": "diffusion",
   "show": "Most fires in a cabin are diffusion flames.",
   "start": 18.808,
   "end": 21.803
  },
  {
   "beat": "meet",
   "show": "Fuel and oxygen start apart, and they only burn where they meet, in a thin glowing layer.",
   "start": 22.128,
   "end": 28.642
  },
  {
   "beat": "equation",
   "show": "Every fuel uses a fixed amount of oxygen. One molecule of propane needs five molecules of oxygen to burn completely.",
   "start": 29.152,
   "end": 37.407
  },
  {
   "beat": "starve",
   "show": "If the oxygen near the flame runs low, the burning slows down.",
   "start": 37.86,
   "end": 41.621
  },
  {
   "beat": "kinds",
   "show": "NASA has tested three kinds of fuel in microgravity: gases, liquid droplets, and solids.",
   "start": 42.236,
   "end": 48.123
  },
  {
   "beat": "counts",
   "show": "This database holds 660 gas flame tests, 353 droplet tests, and 263 tests of solid materials.",
   "start": 48.576,
   "end": 57.294
  },
  {
   "beat": "solids",
   "show": "Solids matter most, because a spacecraft is full of them: fabric, plastic, and wiring.",
   "start": 57.991,
   "end": 65.34
  }
 ],
