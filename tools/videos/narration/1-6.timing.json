{
 "id": "1-6",
 "voice": "onwK4e9ZLuTAKqWW03F9",
 "script_hash": "a15f83595e48b0b4d5266dc2a72c04b81f15d91c26d492c5f1ebec68b18f5a76",
 "duration": 66.92,
 "sentences": [
  {
   "beat": "balance",
   "show": "A flame survives only while it makes heat faster than it loses it.",
   "start": 0.0,
   "end": 4.261
  },
  {
   "beat": "less_heat",
   "show": "Lower the oxygen, and the flame makes less heat.",
   "start": 4.644,
   "end": 7.918
  },
  {
   "beat": "goes_out",
   "show": "At some point the losses win, and the flame goes out on its own.",
   "start": 8.359,
   "end": 12.91
  },
  {
   "beat": "limit",
   "show": "The oxygen level where that happens is called the flammability limit. For choosing cabin materials, it may be the most useful number there is.",
   "start": 13.421,
   "end": 23.243
  },
  {
   "beat": "flex",
   "show": "NASA's FLEX experiment burned hundreds of fuel droplets at different oxygen levels.",
   "start": 23.847,
   "end": 30.07
  },
  {
   "beat": "low_band",
   "show": "Below fifteen percent oxygen, twenty seven of twenty eight droplet flames went out on their own.",
   "start": 30.674,
   "end": 37.93
  },
  {
   "beat": "high_band",
   "show": "Between thirty and fifty percent, only two of twenty four did. Four kept burning, and the rest were not recorded.",
   "start": 38.36,
   "end": 47.624
  },
  {
   "beat": "caution",
   "show": "FLEX changed other things too, like the fuel and the pressure, so this is a pattern, not a controlled test of oxygen alone.",
   "start": 48.309,
   "end": 56.75
  },
  {
   "beat": "direction",
   "show": "But the direction is clear.",
   "start": 57.075,
   "end": 58.875
  },
  {
   "beat": "risk",
   "show": "More oxygen means flames that are harder to stop: the fire risk side of every high oxygen habitat.",
   "start": 59.2,
   "end": 66.92
  }
 ],
 "voice_name": "Daniel (ElevenLabs)",
