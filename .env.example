# Copy to .env.local for local work and fill in. Never commit .env.local.
# On Vercel, set these in Project Settings, Environment Variables (not in any file).
# Used only by api/chat.js (the SI assistant). The site still works with them unset: the rule-based fallback answers.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
# Used by alanzim/learn/videos/tts.py to narrate the learners page videos (build time only, never on the site).
ELEVENLABS_API_KEY=
