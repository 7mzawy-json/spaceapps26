{
 "id": "1-5",
 "voice": "onwK4e9ZLuTAKqWW03F9",
 "script_hash": "bfcda2b22e5b98bae2ad250019084beaf14c155a8ae013874e63f6bedc07d4e6",
 "duration": 64.97,
 "sentences": [
  {
   "beat": "mixing",
   "show": "Pressure changes how fast gases mix.",
   "start": 0.0,
   "end": 2.868
  },
  {
   "beat": "spacing",
   "show": "At lower pressure, gas molecules are further apart, so they collide less often and spread out faster.",
   "start": 3.251,
   "end": 10.159
  },
  {
   "beat": "halve",
   "show": "Halve the pressure, and gases spread about twice as fast.",
   "start": 10.67,
   "end": 14.64
  },
  {
   "beat": "earth",
   "show": "On Earth, rising hot air does most of the mixing, so this barely matters.",
   "start": 15.151,
   "end": 20.608
  },
  {
   "beat": "micro",
   "show": "In microgravity, spreading is the only way oxygen reaches a flame, so it matters a great deal.",
   "start": 21.038,
   "end": 28.108
  },
  {
   "beat": "larger",
   "show": "At low pressure, oxygen arrives from further away. The flame grows larger, and dimmer.",
   "start": 28.793,
   "end": 35.167
  },
  {
   "beat": "moon_pressure",
   "show": "A Moon Base would run at about 10.2 psi, well below the space station's 14.7.",
   "start": 35.863,
   "end": 43.92
  },
  {
   "beat": "evidence",
   "show": "So the evidence that counts comes from tests at the right pressure, not only the right oxygen percent.",
   "start": 44.362,
   "end": 50.735
  },
  {
   "beat": "count",
   "show": "NASA's database holds 33 microgravity tests in the Moon Base range.",
   "start": 51.432,
   "end": 57.203
  },
  {
   "beat": "droplets",
   "show": "All of them burned fuel droplets. None tested a gas flame or a cabin material in that atmosphere.",
   "start": 57.713,
   "end": 64.97
  }
 ],
 "voice_name": "Daniel (ElevenLabs)",
