{
 "id": "1-4",
 "voice": "onwK4e9ZLuTAKqWW03F9",
 "script_hash": "cdbea3e3fcaf9b7d34677f912d73ff52a432738f1f12e1d27d37f258d0fc32a4",
 "duration": 69.196,
 "sentences": [
  {
   "beat": "nitrogen",
   "show": "Nitrogen does not burn, but it still plays a big part in every fire.",
   "start": 0.0,
   "end": 4.737
  },
  {
   "beat": "ratio_earth",
   "show": "In Earth's air, every oxygen molecule comes with almost four molecules of nitrogen.",
   "start": 5.178,
   "end": 11.819
  },
  {
   "beat": "sponge",
   "show": "A flame has to heat all of that nitrogen too. It acts like a sponge, soaking up heat.",
   "start": 12.33,
   "end": 19.354
  },
  {
   "beat": "raise",
   "show": "Raise the oxygen percent, and there is less nitrogen to share the heat.",
   "start": 19.865,
   "end": 24.521
  },
  {
   "beat": "moon_ratio",
   "show": "In a Moon Base atmosphere of thirty percent oxygen, each oxygen molecule brings only about two and a third nitrogen molecules.",
   "start": 25.124,
   "end": 33.867
  },
  {
   "beat": "suit",
   "show": "In a spacesuit, filled with pure oxygen, there is none at all.",
   "start": 34.377,
   "end": 39.544
  },
  {
   "beat": "hotter",
   "show": "With less nitrogen to warm, the flame burns hotter, spreads faster, and is harder to put out.",
   "start": 40.044,
   "end": 46.487
  },
  {
   "beat": "same_breath",
   "show": "This is why the same breathing does not mean the same fire risk.",
   "start": 46.986,
   "end": 51.166
  },
  {
   "beat": "diluents",
   "show": "It also explains how some extinguishers work. Carbon dioxide or helium dilutes the oxygen and carries heat away from the flame.",
   "start": 51.851,
   "end": 61.394
  },
  {
   "beat": "flex",
   "show": "NASA's FLEX experiment tested exactly that, on burning droplets aboard the space station.",
   "start": 61.998,
   "end": 69.196
  }
 ],
 "voice_name": "Daniel (ElevenLabs)",
