{
 "id": "1-2",
 "voice": "onwK4e9ZLuTAKqWW03F9",
 "script_hash": "98cc5a16d1b7941f2cf9551bfe10002b916fd30861967c137f7302b9e433726c",
 "duration": 67.384,
 "sentences": [
  {
   "beat": "teardrop",
   "show": "On Earth, a flame has a shape we all know: a flickering teardrop.",
   "start": 0.0,
   "end": 5.19
  },
  {
   "beat": "gravity",
   "show": "That shape comes from gravity.",
   "start": 5.689,
   "end": 7.895
  },
  {
   "beat": "rises",
   "show": "Gas heated by the flame is lighter than the air around it, so it rises, and cooler air rushes in underneath.",
   "start": 8.324,
   "end": 16.602
  },
  {
   "beat": "formula",
   "show": "The push on that hot gas is the difference in density, times gravity.",
   "start": 17.032,
   "end": 21.827
  },
  {
   "beat": "remove_g",
   "show": "Now take gravity away.",
   "start": 22.14,
   "end": 23.65
  },
  {
   "beat": "station",
   "show": "On the space station, nothing is lighter or heavier. Hot gas stays where it is.",
   "start": 24.01,
   "end": 30.058
  },
  {
   "beat": "sphere",
   "show": "Oxygen can only reach the flame by slowly drifting in, so the flame becomes a small, steady, dim blue sphere.",
   "start": 30.476,
   "end": 38.963
  },
  {
   "beat": "smother",
   "show": "Without fresh air arriving, a flame in orbit can even smother itself.",
   "start": 39.613,
   "end": 44.234
  },
  {
   "beat": "scale",
   "show": "The Moon and Mars sit in between, at one sixth and about three eighths of Earth's gravity.",
   "start": 44.71,
   "end": 50.643
  },
  {
   "beat": "count",
   "show": "Every one of NASA's 1,276 fire tests in this database ran in microgravity. Nobody has measured a fire at Moon gravity yet.",
   "start": 51.211,
   "end": 60.639
  },
  {
   "beat": "between",
   "show": "So for a Moon Base, the honest answer lies somewhere between space and Earth.",
   "start": 61.336,
   "end": 67.384
  }
 ],
 "voice_name": "Daniel (ElevenLabs)",
