{
 "id": "1-3",
 "voice": "onwK4e9ZLuTAKqWW03F9",
 "script_hash": "fdbcea50fe2f6bd2b4981a8e802b6118cea31ef8307fcf3c9e5abaf502f5cbd0",
 "duration": 68.638,
 "sentences": [
  {
   "beat": "two_numbers",
   "show": "Two numbers describe the oxygen in a cabin, and they mean very different things.",
   "start": 0.0,
   "end": 5.457
  },
  {
   "beat": "percent",
   "show": "The first is oxygen percent: what share of the gas molecules are oxygen. It controls how easily things burn.",
   "start": 5.968,
   "end": 14.698
  },
  {
   "beat": "partial",
   "show": "The second is oxygen partial pressure: how hard the oxygen alone pushes. It controls whether you can breathe.",
   "start": 15.395,
   "end": 23.754
  },
  {
   "beat": "multiply",
   "show": "To find it, multiply the oxygen share by the total pressure.",
   "start": 24.08,
   "end": 28.515
  },
  {
   "beat": "sea_level",
   "show": "At sea level, that is about twenty one percent of 14.7 psi, or 3.07.",
   "start": 29.211,
   "end": 37.129
  },
  {
   "beat": "spacewalk",
   "show": "Astronauts heading out on spacewalks are helped by a lower cabin pressure.",
   "start": 37.825,
   "end": 42.04
  },
  {
   "beat": "raise",
   "show": "But lower the pressure, and you must raise the oxygen percent to keep breathing the same.",
   "start": 42.643,
   "end": 47.787
  },
  {
   "beat": "moon",
   "show": "A planned Moon Base at 10.2 psi needs about thirty percent oxygen.",
   "start": 48.39,
   "end": 54.636
  },
  {
   "beat": "flammable",
   "show": "Its crew would breathe just as they do on Earth, but the air around them would be far more flammable.",
   "start": 55.077,
   "end": 61.335
  },
  {
   "beat": "trade",
   "show": "That trade, easier spacewalks against greater fire risk, is exactly what Flashpoint maps.",
   "start": 62.032,
   "end": 68.638
  }
 ],
 "voice_name": "Daniel (ElevenLabs)",
