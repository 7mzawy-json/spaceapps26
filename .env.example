# Copy to .env.local and fill in. Never commit .env.local. Names only, no values.
# Used by api/chat.js (the SI assistant). On the live site it is set in Vercel's settings. Without it the
# assistant answers from the built-in rules and says so.
GEMINI_API_KEY=
# Used by alanzim/learn/videos/tts.py to narrate the Learn videos (build time only, never on the site).
ELEVENLABS_API_KEY=
